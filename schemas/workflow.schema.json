{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yangisu/Automate_jev/schemas/workflow.schema.json",
  "title": "Automate Jev MVP Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "allowed_root", "steps", "completion"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "allowed_root": {"type": "string", "minLength": 1, "maxLength": 512},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "action_id", "success", "risk"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "domain": {"enum": ["browser", "desktop", "filesystem", "system"]},
          "action_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
          "success": {"type": "object", "minProperties": 1, "maxProperties": 8},
          "risk": {"enum": ["safe", "confirm", "blocked"]}
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "object", "minProperties": 1, "maxProperties": 2}
        }
      }
    }
  }
}
