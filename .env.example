# Copy this file to .env. Never commit the real key.
jev_api_key=replace-with-your-key
AUTOMATE_JEV_MCP_COMMAND=npx -y mcp-remote https://mcp.notion.com/mcp
AUTOMATE_JEV_SLACK_MCP_COMMAND=python -m automate_jev.slack_mcp_bridge
AUTOMATE_JEV_CALENDAR_MCP_COMMAND=python -m automate_jev.google_calendar_mcp_bridge
GOOGLE_CALENDAR_CREDENTIALS_FILE=/app/.automate-jev/google-calendar-credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=/app/.automate-jev/google-calendar-token.json
GOOGLE_CALENDAR_ID=primary
SLACK_OAUTH_TOKEN=replace-with-slack-oauth-token
AUTOMATE_JEV_SLACK_SERVER=slack
AUTOMATE_JEV_SLACK_SEARCH_TOOL=slack-search-messages
AUTOMATE_JEV_SLACK_QUERY=
AUTOMATE_JEV_MEMORY_ROOT=/app/.automate-jev/memory
AUTOMATE_JEV_TIMEZONE=Asia/Seoul
AUTOMATE_JEV_CALENDAR_SERVER=calendar
AUTOMATE_JEV_CALENDAR_CREATE_TOOL=calendar-create-event
AUTOMATE_JEV_LLM_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
NOTION_ROUTINE_PARENT_ID=replace-with-routines-page-id
NOTION_DAILY_PROGRESS_PARENT_ID=replace-with-daily-progress-page-id
NOTION_PROJECT_ROOT_PAGE_ID=replace-with-project-root-page-id
NOTION_PUBLISH_ENABLED=false
